#define Drive5235040459699079530296_GetDerivatives2_C 1
#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
void Drive5235040459699079530296_fmiGetDerivatives3(void* m, double* dx, int ind) {
  struct dy_fmi2Extended* a = m;
  fmi2Status status=fmi2Fatal;
  if (a) {
    if(a->cpDer){
      status=a->dyFmiGetDerivatives(a->m, a->der, 3);
      a->cpDer = 0;
    }else{
      status=fmi2OK;
    }
  *dx = a->der[ind];
  }
  if (status!=fmi2OK && status!=fmi2Warning) ModelicaError(\"GetDerivatives failed\");

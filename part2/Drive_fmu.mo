void Drive5235040459699079530296_fmiGetOutput(void* m, double* dx, int ind) {
  struct dy_fmi2Extended* a = m;
  fmi2Status status=fmi2Fatal;
  const size_t nvr = 1;
  static const fmi2ValueReference vr[1] = {335544320};
  if (a) {
    if(a->cpOut){
      status=a->dyFmiGetReal(a->m, vr, nvr, a->out);
      a->cpOut = 0;
    }else{
      status=fmi2OK;
    }
  *dx = a->out[ind];
  }
  if (status!=fmi2OK && status!=fmi2Warning) ModelicaError(\"GetDerivatives failed\");

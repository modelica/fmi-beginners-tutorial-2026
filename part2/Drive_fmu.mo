    function fmiGetReal
      input fmiModel fmi;
      input Integer refs[:];
      output Real vals[size(refs, 1)];
      external"C" Drive5235040459699079530296_fmiGetReal2(
        fmi,
        refs,
        size(refs, 1),
        vals)
      annotation (Include="
#ifndef Drive5235040459699079530296_GetReal_C
#define Drive5235040459699079530296_GetReal_C 1
#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
void Drive5235040459699079530296_fmiGetReal2(void*m, const int*refs, size_t nrefs, double*vals) {
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;

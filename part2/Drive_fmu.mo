        refs,
        size(refs, 1),
        vals)
        annotation (Include="
#ifndef Drive5235040459699079530296_GetBoolean_C
#define Drive5235040459699079530296_GetBoolean_C 1
#include \"FMI/fmi2Import.h\"
void Drive5235040459699079530296_fmiGetBoolean2(void*m, const int* refs, size_t nr, int* vals) {
  int i;
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;

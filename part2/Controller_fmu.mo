      annotation (Include="
#ifndef Controller322472072141713855099470_GetInteger_C
#define Controller322472072141713855099470_GetInteger_C 1
#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
void Controller322472072141713855099470_fmiGetInteger2(void*m, const int*refs, size_t nrefs, int*vals) {
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;
  if (a) {

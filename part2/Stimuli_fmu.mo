#define Stimuli785933285418837546192073_fmiCheckIfDiscreteValueSet_C 1
#include \"FMI/fmi2Import.h\"
double Stimuli785933285418837546192073_fmiCheckIfDiscreteValueSet2(void*m) {
  struct dy_fmi2Extended*a=m;
  if (a) {
    return a->discreteInputChanged;
  }
  ModelicaError(\"fmiCheckIfDiscreteValueSet2 failed!\");
  return 0;
}
#endif", Library="Stimuli", LibraryDirectory="modelica://Stimuli_fmu/Resources/Library/FMU/Stimuli/binaries");

    res->m=res->dyFmiInstantiate(instanceName, fmi2ModelExchange, \"{785c933e-28e5-418c-8375-461e92c073dd}\",resourceLocation, &funcs, fmi2False, loggingOn);
    res->der = calloc(0,sizeof(double));

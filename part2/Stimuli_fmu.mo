    function  fmiSetTime
    input fmiModel fmi;
    input Real ti;
    external"C" Stimuli785933285418837546192073_fmiSetTime2(fmi, ti)
    annotation (Include="
#ifndef Stimuli785933285418837546192073_SetTime_C
#define Stimuli785933285418837546192073_SetTime_C 1
#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
void Stimuli785933285418837546192073_fmiSetTime2(void*m, double ti) {
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;
  if (a) {
    if(ti > a->dyTime || (a->currentMode == dyfmi2EventMode && ti==a->dyTime && !isModelicaEvent())){
      a->dyTime=ti;
      if(a->currentMode == dyfmi2EventMode){
        status = a->dyFmiEnterContinuousTimeMode(a->m);
        if (status!=fmi2OK && status!=fmi2Warning) ModelicaError(\"fmiEnterContinuousTimeMode failed!\");
        a->currentMode = dyfmi2ContinuousTimeMode;
      }
      status=a->dyFmiSetTime(a->m, ti);
    }else if(ti < a->dyTime && a->currentMode == dyfmi2ContinuousTimeMode){
      a->dyTime=ti;
      status=a->dyFmiSetTime(a->m, ti);
      a->cpDer = 1;
      a->cpOut = 1;
    }else{
      status=fmi2OK;
    }
  }
  if (status!=fmi2OK ) ModelicaError(\"SetTime failed\");
}
#endif", Library="Stimuli", LibraryDirectory="modelica://Stimuli_fmu/Resources/Library/FMU/Stimuli/binaries");
      annotation (
        __Dymola_doNotLinkSharedObject=true,
        __Dymola_CriticalRegion="Stimuli",
        __Dymola_LockExternalObject=true,
        __Dymola_IdemPotent=true);
    end fmiSetTime;


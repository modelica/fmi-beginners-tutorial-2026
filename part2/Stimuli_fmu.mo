#ifndef Stimuli785933285418837546192073_Free_C
#define Stimuli785933285418837546192073_Free_C 1
#include \"FMI/fmi2Import.h\"
#include <stdlib.h>
void Stimuli785933285418837546192073_fmiFreeModelInstance2(void*m) {
  struct dy_fmi2Extended*a=m;
  if (a) {
    if(a->dyFMUstate)
    a->dyFmiFreeFMUstate(a->m, &a->dyFMUstate);
    /*a->dyFmiSetDebugLogging(a->m,fmi2True,0,NULL);*/
    a->dyFmiTerminate(a->m);
    a->dyFmiFreeInstance(a->m);
    FreeLibrary(a->hInst);
    free(a->der);a->der=0;
    free(a->out);a->out=0;
    free(a);
  }
}
#endif",       Library="Stimuli", LibraryDirectory="modelica://Stimuli_fmu/Resources/Library/FMU/Stimuli/binaries");

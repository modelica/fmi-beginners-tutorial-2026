    function fmiRestoreFMUState
      input fmiModel fmi;
      external"C" Stimuli785933285418837546192073_fmiRestoreFMUState2(fmi)
        annotation (Include="
#ifndef Stimuli785933285418837546192073_fmiRestoreFMUState_C
#define Stimuli785933285418837546192073_fmiRestoreFMUState_C 1
#include \"FMI/fmi2Import.h\"
